{
  "name": "devcon-monorepo",
  "version": "0.0.1",
  "description": "Devcon Monorepo",
  "private": true,
  "scripts": {
    "dev:devconnect": "node init && pnpm --filter devconnect dev",
    "build:devconnect": "node init && pnpm --filter devconnect build",
    "start:devconnect": "node init && pnpm --filter devconnect start",
    "dev:devconnect-app": "node init && pnpm --filter devconnect-app dev",
    "build:devconnect-app": "node init && pnpm --filter devconnect-app build",
    "start:devconnect-app": "node init && pnpm --filter devconnect-app start",
    "dev:archive": "node init && pnpm --filter archive dev",
    "build:archive": "node init && pnpm --filter archive build",
    "start:archive": "node init && pnpm --filter archive start",
    "dev:devcon": "node init && pnpm --filter devcon dev",
    "build:devcon": "node init && pnpm --filter devcon build",
    "start:devcon": "node init && pnpm --filter devcon start",
    "dev:devcon-app": "node init && pnpm --filter devcon-app dev",
    "build:devcon-app": "node init && pnpm --filter devcon-app build",
    "start:devcon-app": "node init && pnpm --filter devcon-app start",
    "dev:devcon-api": "node init && pnpm --filter devcon-api dev",
    "build:devcon-api": "node init && pnpm --filter devcon-api build",
    "start:devcon-api": "node init && pnpm --filter devcon-api start",
    "dev:perks-portal": "node init && pnpm --filter perks-portal dev",
    "build:perks-portal": "node init && pnpm --filter perks-portal build",
    "start:perks-portal": "node init && pnpm --filter perks-portal start"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "devconnect>@reown/appkit": "1.7.17",
      "devconnect>@reown/appkit-adapter-wagmi": "1.7.17",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "sharp": "^0.33.5"
    },
    "ignoredBuiltDependencies": [
      "canvas",
      "protobufjs",
      "sharp"
    ]
  },
  "devDependencies": {
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@getpara/react-common": "2.0.0-alpha.70"
  }
}
